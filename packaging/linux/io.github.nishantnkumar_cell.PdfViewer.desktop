[Desktop Entry]
Type=Application
Name=PDF Viewer
GenericName=Document Viewer
Comment=View, annotate and fill in PDF files, fully offline
Exec=pdf-viewer %f
Icon=io.github.nishantnkumar_cell.PdfViewer
Terminal=false
Categories=Office;Viewer;
MimeType=application/pdf;application/x-pdf;
Keywords=pdf;document;viewer;annotate;form;
StartupNotify=true
StartupWMClass=io.github.nishantnkumar_cell.PdfViewer
SingleMainWindow=false
